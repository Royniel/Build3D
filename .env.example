# Copy to .env and adjust. docker-compose reads .env automatically.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate a real one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django

# Optional: used by `manage.py createsuperuser --noinput` if you want an
# admin login without the interactive prompt.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin-pass-12345
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=build3d
POSTGRES_USER=build3d
POSTGRES_PASSWORD=build3d

# Host used by Django. Inside docker-compose this is the service name
# "postgres"; set it to localhost when running manage.py from your shell.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Port Postgres is published on *your machine*. Defaults to 5433 so it does
# not clash with a Postgres you may already have listening on 5432. When you
# run the test suite from the host, point POSTGRES_PORT at this value.
POSTGRES_HOST_PORT=5433

# Escape hatch: set to 1 to make Django use a local SQLite file instead of
# Postgres. Handy for running pytest with no containers at all.
USE_SQLITE=

# ---------------------------------------------------------------------------
# Integration with the FastAPI quoting service
# ---------------------------------------------------------------------------
# Inside compose: http://quoting:8001. From your shell: http://localhost:8001
QUOTING_SERVICE_URL=http://quoting:8001
# Seconds before Django gives up and saves the order as quote_pending.
QUOTING_SERVICE_TIMEOUT=3.0
